# =============================================================================
# Trigger.dev
# =============================================================================

# Your project ref from the Trigger.dev dashboard (e.g. proj_abc123).
# Also set this in trigger.config.ts before deploying.
TRIGGER_PROJECT_ID=proj_replace_me

# Runtime secret key — found under your project's API Keys page.
# Used by server.ts (tasks.trigger) at runtime. NOT used by the CLI.
TRIGGER_SECRET_KEY=tr_dev_replace_me

# Personal access token from your Trigger.dev profile page.
# Used ONLY by the CLI for `npm run deploy` and the GitHub Actions deploy step.
TRIGGER_ACCESS_TOKEN=tr_pat_replace_me

# =============================================================================
# Anthropic
# =============================================================================

# API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-replace_me

# =============================================================================
# n8n Webhooks
# Each URL is copied from the corresponding n8n workflow's Webhook node.
# =============================================================================

N8N_WEBHOOK_CONTRACT=https://your-n8n-instance.com/webhook/contract
N8N_WEBHOOK_EMAIL=https://your-n8n-instance.com/webhook/email
N8N_WEBHOOK_CRM=https://your-n8n-instance.com/webhook/crm
N8N_WEBHOOK_CALENDLY=https://your-n8n-instance.com/webhook/calendly
N8N_WEBHOOK_GMAIL=https://your-n8n-instance.com/webhook/gmail

# =============================================================================
# Webhook receiver (server.ts)
# =============================================================================

# Port for the Hono webhook receiver to listen on (default: 3000)
PORT=3000

# Optional shared secret for the manual /webhook/client-intake endpoint.
# When set, requests must include the header: x-webhook-secret: <this value>
# The Tally endpoint (/webhook/tally) does not use this header.
# Leave blank to disable.
WEBHOOK_SECRET=replace_with_a_random_string

# =============================================================================
# Tally
# =============================================================================

# Point your Tally form webhook to: https://<your-server>/webhook/tally
# No env var is required on this side — Tally POSTs directly to the server.
# If you want to verify Tally's HMAC signature (advanced), retrieve the signing
# secret from your Tally form → Integrate → Webhooks and add it here:
# TALLY_SIGNING_SECRET=replace_with_tally_signing_secret
